---
import Layout from "../../../layouts/basiclayout.astro";
import { createClient } from "@supabase/supabase-js";

export const prerender = false;
const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const id = Astro.params.id;

const access = Astro.cookies.get("sb-access-token")?.value;
const refresh = Astro.cookies.get("sb-refresh-token")?.value;

let userId: string | null = null;
if (access && refresh) {
  const { data } = await supabase.auth.setSession({
    access_token: access,
    refresh_token: refresh,
  });
  userId = data.user?.id ?? null;
}

const { data: post, error: postErr } = await supabase
  .from("posts")
  .select("id, title, content_md, author_id")
  .eq("id", id)
  .single();

const canEdit = !!userId && !!post && post.author_id === userId;
---

<Layout title="Edit post">
  <div class="mx-auto max-w-2xl px-4 py-10">
    <a class="text-sm underline" href={`/blog/${id}`}>← Back</a>

    {postErr || !post ? (
      <p class="mt-6 text-sm text-red-600">{postErr?.message ?? "Post not found"}</p>
    ) : !userId ? (
      <p class="mt-6 text-sm text-gray-600">
        Please <a class="underline" href="/signin">log in</a>.
      </p>
    ) : !canEdit ? (
      <p class="mt-6 text-sm text-gray-600">You can edit only your own post.</p>
    ) : (
      <>
        <h1 class="mt-4 text-2xl font-semibold">Edit post</h1>

        <form id="editForm" class="mt-6 space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Title</label>
            <input
              id="title"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none bg-gray-50 focus:bg-white"
              value={post.title}
              required
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Content</label>
            <textarea
              id="content_md"
              rows="10"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none bg-gray-50 focus:bg-white"
              required
            >{post.content_md}</textarea>
          </div>

          <div class="flex gap-3">
            <button
              type="submit"
              class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-lg"
            >
              Save
            </button>
            <a class="py-3 px-4 rounded-lg border border-gray-300" href={`/blog/${id}`}>Cancel</a>
          </div>
        </form>

        <script define:vars={{ id }}>
          const form = document.getElementById("editForm");
          form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            const titleEl = document.getElementById("title");
            const contentEl = document.getElementById("content_md");

            const title = titleEl instanceof HTMLInputElement ? titleEl.value.trim() : "";
            const content_md = contentEl instanceof HTMLTextAreaElement ? contentEl.value.trim() : "";

            const r = await fetch(`/api/blog/${id}`, {
              method: "PUT",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ title, content_md }),
            });

            if (r.ok) location.href = `/blog/${id}`;
            else alert(await r.text());
          });
        </script>
      </>
    )}
  </div>
</Layout>
