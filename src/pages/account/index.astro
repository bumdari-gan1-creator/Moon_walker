---
import Layout from "../../layouts/basiclayout.astro";
import { createClient } from "@supabase/supabase-js";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const access = Astro.cookies.get("sb-access-token")?.value;
const refresh = Astro.cookies.get("sb-refresh-token")?.value;

let userId: string | null = null;

if (access && refresh) {
  const { data } = await supabase.auth.setSession({
    access_token: access,
    refresh_token: refresh,
  });
  userId = data.user?.id ?? null;
}

let profile = { username: "", full_name: "", bio: "" };

if (userId) {
  const { data } = await supabase
    .from("profiles")
    .select("username, full_name, bio")
    .eq("id", userId)
    .maybeSingle();

  if (data) {
    profile = {
      username: data.username ?? "",
      full_name: data.full_name ?? "",
      bio: data.bio ?? "",
    };
  }
}
---

<Layout title="Account settings">
  <div class="mx-auto max-w-2xl px-4 py-10">
    <a class="text-sm underline" href="/">← Back</a>

    {!userId ? (
      <p class="mt-6 text-sm text-gray-600">
        Please <a class="underline" href="/signin">log in</a>.
      </p>
    ) : (
      <>
        <h1 class="mt-4 text-2xl font-semibold">Account settings</h1>

        <!-- Profile -->
        <form id="profileForm" class="mt-6 space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Username</label>
            <input
              id="username"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none bg-gray-50 focus:bg-white"
              value={profile.username}
              placeholder="username"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Full name</label>
            <input
              id="full_name"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none bg-gray-50 focus:bg-white"
              value={profile.full_name}
              placeholder="Your name"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Bio</label>
            <textarea
              id="bio"
              rows="4"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none bg-gray-50 focus:bg-white"
              placeholder="Short bio"
            >{profile.bio}</textarea>
          </div>

          <p id="profileMsg" class="text-sm"></p>

          <div class="flex gap-3">
            <button
              type="submit"
              class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-lg"
            >
              Save profile
            </button>
            <a class="py-3 px-4 rounded-lg border border-gray-300" href="/blog">Cancel</a>
          </div>
        </form>

        <hr class="my-10" />

        <!-- Password form -->
        <h2 class="text-xl font-semibold">Change password</h2>

        <form id="passForm" class="mt-4 space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">New password</label>
            <input
              id="password"
              type="password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none bg-gray-50 focus:bg-white"
              placeholder="At least 6 characters"
              required
            />
          </div>

          <p id="passMsg" class="text-sm"></p>

          <button
            type="submit"
            class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-lg"
          >
            Update password
          </button>
        </form>

        <script>
          (function () {
            const profileForm = document.getElementById("profileForm");
            const profileMsg = document.getElementById("profileMsg");

            profileForm?.addEventListener("submit", async (e) => {
              e.preventDefault();

              const u = document.getElementById("username");
              const f = document.getElementById("full_name");
              const b = document.getElementById("bio");

              const username = u instanceof HTMLInputElement ? u.value : "";
              const full_name = f instanceof HTMLInputElement ? f.value : "";
              const bio = b instanceof HTMLTextAreaElement ? b.value : "";

              const r = await fetch("/api/account/profile", {
                method: "PATCH",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ username, full_name, bio }),
              });

              const j = await r.json().catch(() => ({}));
              if (profileMsg) {
                profileMsg.className = "text-sm " + (r.ok ? "text-green-600" : "text-red-600");
                profileMsg.textContent = r.ok ? "Saved." : (j.error || "Error");
              }
            });

            const passForm = document.getElementById("passForm");
            const passMsg = document.getElementById("passMsg");

            passForm?.addEventListener("submit", async (e) => {
              e.preventDefault();

              const p = document.getElementById("password");
              const password = p instanceof HTMLInputElement ? p.value : "";

              const r = await fetch("/api/account/password", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ password }),
              });

              const j = await r.json().catch(() => ({}));
              if (passMsg) {
                passMsg.className = "text-sm " + (r.ok ? "text-green-600" : "text-red-600");
                passMsg.textContent = r.ok ? "Password updated." : (j.error || "Error");
              }

              if (r.ok && p instanceof HTMLInputElement) p.value = "";
            });
          })();
        </script>
      </>
    )}
  </div>
</Layout>
